VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_ORGANIZATION_ID=
VITE_REQUIRE_SUPABASE_AUTH_FOR_BACKEND=false
# Resend email secrets are Supabase Edge Function secrets, not Vite/frontend env vars.

# Supabase Edge Function secrets for google-calendar-sync.
# Set these in Supabase Dashboard or with `supabase secrets set`.
# Do NOT expose these to Vite/frontend.
# GOOGLE_CALENDAR_CLIENT_EMAIL=
# GOOGLE_CALENDAR_PRIVATE_KEY=
# GOOGLE_CALENDAR_PRIVATE_KEY_ID=
# GOOGLE_CALENDAR_IMPERSONATED_USER=
# GOOGLE_CALENDAR_SCOPES=
# GOOGLE_CALENDAR_ICS_URL=
# GOOGLE_CALENDAR_ICS_URL_MY_0_COMMUNITY_STAGE_200=
# GOOGLE_CALENDAR_ICS_URL_MY_1_ATRIUM_100=
# GOOGLE_CALENDAR_ICS_URL_MY_1_BAR_20=
# GOOGLE_CALENDAR_ICS_URL_MY_1_LOUNGE_VENUE_40=
# GOOGLE_CALENDAR_ICS_URL_MY_1_WORKBAR_100=
# SUPABASE_SERVICE_ROLE_KEY is also server-side only.
# SUPABASE_SERVICE_ROLE_KEY=
